{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "street-legends",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": { "directory": "../web/dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "street-legends", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "APP_URL": "https://replace-me.workers.dev", "BOT_USERNAME": "", "ALLOWED_ORIGIN": "" },
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 0.1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "triggers": { "crons": ["*/15 * * * *"] }
}
