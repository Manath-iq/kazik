{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "street-legends-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-11-04",
  "durable_objects": { "bindings": [{ "name": "CASINO_ROOMS", "class_name": "CasinoRoom" }] },
  "migrations": [{ "tag": "casino-v1", "new_sqlite_classes": ["CasinoRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "street-legends", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "APP_URL": "http://127.0.0.1:5174", "BOT_USERNAME": "", "ALLOWED_ORIGIN": "http://127.0.0.1:5174", "STARS_ENABLED": "false", "PAYMENT_SUPPORT_USERNAME": "manath" }
}
