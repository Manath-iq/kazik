  "vars": { "APP_URL": "https://street-legends-test.todominate-ai.workers.dev", "BOT_USERNAME": "kaziktesttg_bot", "ALLOWED_ORIGIN": "https://street-legends-test.todominate-ai.workers.dev", "STARS_ENABLED": "true", "PAYMENT_SUPPORT_USERNAME": "manath" },
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 0.1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
